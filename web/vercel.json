{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/auth/callback", "destination": "/api/auth.js" },
    { "source": "/api/auth", "destination": "/api/auth.js" },
    { "source": "/api/stats", "destination": "/api/stats.js" },
    { "source": "/api/orders", "destination": "/api/orders.js" },
    { "source": "/api/settings", "destination": "/api/settings.js" },
    { "source": "/api/billing/:path*", "destination": "/api/billing.js" },
    { "source": "/api/webhook", "destination": "/api/webhook.js" },
    { "source": "/api/whatsapp", "destination": "/api/whatsapp.js" },
    { "source": "/api/whatsapp/:path*", "destination": "/api/whatsapp.js" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
