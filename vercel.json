{
  "version": 2,
  "builds": [
    {
      "src": "web/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    { "src": "api/stats.js", "use": "@vercel/node" },
    { "src": "api/orders.js", "use": "@vercel/node" },
    { "src": "api/settings.js", "use": "@vercel/node" },
    { "src": "api/billing.js", "use": "@vercel/node" },
    { "src": "api/webhook.js", "use": "@vercel/node" },
    { "src": "api/whatsapp.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/stats", "dest": "/api/stats.js" },
    { "src": "/api/orders", "dest": "/api/orders.js" },
    { "src": "/api/settings", "dest": "/api/settings.js" },
    { "src": "/api/billing/(.*)", "dest": "/api/billing.js" },
    { "src": "/api/webhook/(.*)", "dest": "/api/webhook.js" },
    { "src": "/api/whatsapp/(.*)", "dest": "/api/whatsapp.js" },
    { "src": "/(.*)", "dest": "/web/dist/$1" }
  ]
}
