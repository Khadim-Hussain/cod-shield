{
  "version": 2,
  "outputDirectory": "web/dist",
  "installCommand": "npm install && node -e \"require('child_process').execSync('npm install', {cwd: 'web', stdio: 'inherit'})\"",
  "buildCommand": "node -e \"require('child_process').execSync('npm run build', {cwd: 'web', stdio: 'inherit'})\"",
  "framework": null,
  "routes": [
    { "src": "/api/stats", "dest": "/api/stats.js" },
    { "src": "/api/orders", "dest": "/api/orders.js" },
    { "src": "/api/settings", "dest": "/api/settings.js" },
    { "src": "/api/billing/(.*)", "dest": "/api/billing.js?path=$1" },
    { "src": "/api/webhook/(.*)", "dest": "/api/webhook.js" },
    { "src": "/api/whatsapp/(.*)", "dest": "/api/whatsapp.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
